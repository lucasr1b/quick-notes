{
  "name": "quick-notes",
  "version": "0.1.0",
  "description": "A floating scratchpad for macOS. One shortcut, a note on top of everything, files you own.",
  "author": "Lucas Ribeiro",
  "license": "MIT",
  "homepage": "https://lucascodes.net/quick-notes",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucasr1b/quick-notes.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "electron:dev": "concurrently \"next dev -p 3800\" \"wait-on http://localhost:3800 && electron .\"",
    "electron:build": "next build && electron-builder --mac",
    "electron:start": "electron .",
    "app": "npm run build && electron-builder --mac --dir",
    "release": "next build && electron-builder --mac --publish always",
    "demo": "node scripts/demo.js"
  },
  "dependencies": {
    "electron-serve": "^3.0.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tiptap/extension-image": "^3.22.4",
    "@tiptap/extension-link": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/extension-text-align": "^3.20.0",
    "@tiptap/extension-underline": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "^4",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "net.lucascodes.quick-notes",
    "productName": "Quick Notes",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "**/*",
      "!src/**",
      "!.next/**",
      "!dist-electron/**",
      "!public/**",
      "!build/**",
      "!*.md",
      "!next.config.ts",
      "!postcss.config.mjs",
      "!tsconfig.json",
      "!next-env.d.ts",
      "!*.tsbuildinfo",
      "!.npmignore",
      "!scripts/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Quick-Notes-${version}-${arch}-mac.${ext}",
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "artifactName": "Quick-Notes-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lucasr1b",
        "repo": "quick-notes",
        "releaseType": "draft"
      }
    ]
  },
  "private": true
}
